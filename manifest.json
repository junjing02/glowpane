{
  "manifest_version": 3,
  "name": "Glowpane: Comments Beside the Video for YouTube",
  "short_name": "Glowpane",
  "version": "1.10.5",
  "description": "Read YouTube comments without losing the video: a resizable side-by-side layout with ambient light and a synced two-window mode.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Glowpane",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-split": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Turn the split layout on or off"
    },
    "toggle-two-windows": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Turn Two windows on or off"
    },
    "toggle-video-only": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Hide or show the side pane (video only)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/early.js"
      ],
      "css": [
        "src/early.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/page.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
